# Use the Supabase session pooler connection string for patchguard_backend.
SUPABASE_DB_URL=postgresql://patchguard_backend.YOUR_PROJECT_REF:CHANGE_ME@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
AUTH_SECRET=replace-with-at-least-32-random-characters
REPAIR_INTERNAL_SECRET=replace-with-a-separate-long-random-secret
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:8000
BACKEND_PORT=8000
DEMO_EMAIL=
DEMO_PASSWORD=
ANALYSIS_MODE=legacy


# Optional hosted repair provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional local Ollama endpoint
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=2048

# Optional Groq repair provider. Deep repair is opt-in and uses high reasoning effort.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DEEP_MODEL=openai/gpt-oss-120b
MAX_REPAIR_CONTEXT_CHARS=24000
MAX_DEEP_REPAIR_CONTEXT_CHARS=48000

MAX_REPAIR_CHANGED_LINES=200
