# Use the Supabase session pooler connection string for patchguard_backend.
SUPABASE_DB_URL=postgresql://patchguard_backend.YOUR_PROJECT_REF:CHANGE_ME@YOUR_POOLER_HOST:5432/postgres?sslmode=require
https://wdexpahhtkapnxdmigbq.supabase.co 


# Optional hosted repair provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional local Ollama endpoint
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_PREDICT=2048

# Optional Groq repair provider. Deep repair is opt-in and uses high reasoning effort.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DEEP_MODEL=openai/gpt-oss-120b
MAX_REPAIR_CONTEXT_CHARS=24000
MAX_DEEP_REPAIR_CONTEXT_CHARS=48000

# Shared only by the API and worker for private model-generation requests.
REPAIR_INTERNAL_SECRET=replace-with-a-long-random-secret
