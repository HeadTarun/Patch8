# Use the Supabase session pooler connection string for patchguard_backend.
SUPABASE_DB_URL=postgresql://patchguard_backend.YOUR_PROJECT_REF:CHANGE_ME@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# GitHub OAuth client credentials are configured in Supabase Auth, not in this app's .env.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:8000
# Optional demo sign-in. Create this account in Supabase Auth first; keep access read-only.
DEMO_EMAIL=
DEMO_PASSWORD=

# Optional hosted repair provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional local Ollama endpoint
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=12000

# Optional Groq fallback for automatic repair proposals
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MAX_REPAIR_CONTEXT_CHARS=24000
MAX_REPAIR_CHANGED_LINES=200

# Optional Spline scene. Leave empty to use the static hero poster.
NEXT_PUBLIC_SPLINE_SCENE_URL=
